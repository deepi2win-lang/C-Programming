#include <stdio.h>

int main(){
   int n,i,j,count,maxcount=0;
   int maxelement;
   scanf("%d",&n);
   int a[n];
   for(i=0;i<n;i++){
       scanf("%d",&a[i]);
   }
   for(i=0;i<n;i++){
       count=0;
       for(j=0;j<n;j++){
           if(a[i]==a[j]){
               count++;
           }
       }
       if(count>maxcount){
           maxcount=count;
           maxelement=a[i];
       }
   }
   printf("max repeating element=%d\n",maxelement);
   printf("no of occurence =%d",maxcount);
   

    return 0;
}
