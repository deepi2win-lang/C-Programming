#include <stdio.h>

int main(){
    int n,i,j,flag;
    scanf("%d",&n);
    int a[n];
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++){
        flag=0;
        for(j=2;j<a[i];j++){
            if(a[i]%j==0){
                flag++;
            }
        }
        if(flag!=0){
            printf("%d ",a[i]);
        }
    }


    return 0;
}
