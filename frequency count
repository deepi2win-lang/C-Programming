#include<stdio.h>

int main(){
    int n,i,j,k,alreadycounted;
    scanf("%d",&n);
    int a[n];
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++){
        alreadycounted=0;
        for(k=0;k<i;k++){
            if(a[i]==a[k]){
            alreadycounted=1;
            break;}
        }
        if(alreadycounted==1){
            continue;
        }
        int count=0;
        for(j=0;j<n;j++){
            if(a[i]==a[j]){
                count++;
            }
        }

    
        printf("%d->%d\n",a[i],count);
    
}
}
