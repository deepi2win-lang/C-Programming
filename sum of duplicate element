#include <stdio.h>

int main(){
    int n,i,s=0,j,count;
    scanf("%d",&n);
    int a[n];
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++){
         count=0;
        for(j=i+1;j<n;j++){
            if(a[i]==a[j]){
                count++;
            }
        }
    
    if(count!=0){
        printf("%d ",a[i]);
        s=s+a[i];
    }
    }
    printf("\n%d",s);


    return 0;
}
