#include <stdio.h>

int main() {
    int n, i, j, temp;
    float median;
    scanf("%d", &n);

    int a[n];
    
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }

    
    if (n % 2 != 0) {
        median = a[n / 2];
    } else {
        median = (a[n / 2 - 1] + a[n / 2]) / 2.0;
    }

    printf("Median = %.2f\n", median);

    return 0;
}
