#include <stdio.h>

int main(){
  int n,i,j;
  scanf("%d",&n);
  int a[n];
  for(i=0;i<n;i++){
  scanf("%d",&a[i]);
  }
  int s=0;
  int largestsum=a[0]+a[1];
  int x=a[0];
  int y=a[1];
  for(i=0;i<n;i++){
      for(j=i+1;j<n;j++){
          
          s=a[i]+a[j];
          
      if(s>largestsum){
          largestsum=s;
          x=a[i];
          y=a[j];
      }
      }
  }
  printf("pair=%d %d",x,y);
  printf("\nlargest sum=%d",largestsum);

    return 0;
}
