#include <stdio.h>

int main(){
    int n,i,j;
    scanf("%d",&n);
    int a[n];
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++){
        
        if(i%2==0 && a[i]%2==0){
            
            for(j=i;j<n-1;j++){
                a[j]=a[j+1];
            }
            n--;
            i--;
        }
    }
    for(i=0;i<n;i++){
        printf("%d ",a[i]);
    }
    
    return 0;
}
